{
  "version": 3,
  "port": 8080,
  "endpoints": [
    {
      "endpoint": "/users",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "host": ["http://users:8000"],
          "url_pattern": "/users",
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/users/{id}",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "host": ["http://users:8000"],
          "url_pattern": "/users/{id}",
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/orders",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "host": ["http://orders:8000"],
          "url_pattern": "/orders",
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/orders",
      "method": "GET",
      "output_encoding": "no-op",
      "input_query_strings": ["limit", "offset"],
      "backend": [
        {
          "host": ["http://orders:8000"],
          "url_pattern": "/orders",
          "encoding": "no-op"
        }
      ],
      "extra_config": {
          "auth/validator": {
            "alg": "RS256",
            "jwk_url": "http://users:8000/.well-known/jwks.json",
            "disable_jwk_security": true,
            "cache": true
        }
      }
    },
    {
      "endpoint": "/orders/{id}",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "host": ["http://orders:8000"],
          "url_pattern": "/orders/{id}",
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/login",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "host": ["http://users:8000"],
          "url_pattern": "/login",
          "encoding": "no-op"
        }
      ]
    }
  ]
}
